@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Include the targets file generated by CMake
include("${CMAKE_CURRENT_LIST_DIR}/RingCacheTargets.cmake")

# Provide convenient and standard namespaced targets: RingCache::client and RingCache::ringcache
if(TARGET RingCache::ringcache_client)
    if(NOT TARGET RingCache::client)
        add_library(RingCache::client INTERFACE IMPORTED)
        set_target_properties(RingCache::client PROPERTIES
            INTERFACE_LINK_LIBRARIES RingCache::ringcache_client
        )
    endif()
    if(NOT TARGET RingCache::ringcache)
        add_library(RingCache::ringcache INTERFACE IMPORTED)
        set_target_properties(RingCache::ringcache PROPERTIES
            INTERFACE_LINK_LIBRARIES RingCache::ringcache_client
        )
    endif()
endif()

check_required_components(RingCache)
